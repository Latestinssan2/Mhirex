<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_panel_background"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="Templates"
        android:textColor="@color/textColor"
        android:textSize="21sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:text="Choose a visual style to add editable effects to your timeline."
        android:textColor="@color/toolTextInactive"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateFreezeSkull"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#667C8799"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Freeze and skull template preview" android:src="@drawable/template_preview_freeze" android:scaleType="centerCrop" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Freeze + ☠" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Mono freeze frame" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateBirthday"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Birthday frame and balloon template preview" android:src="@drawable/template_preview_birthday" android:scaleType="centerCrop" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Happy Birthday" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Frames + balloons" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateNoir"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#667C8799"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Noir video template preview" android:src="@drawable/template_preview_noir" android:scaleType="centerCrop" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Noir montage" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="B&amp;W + transitions" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateSlowMoment"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#667C8799"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Slow motion template preview" android:src="@drawable/template_preview_slow" android:scaleType="centerCrop" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Slow this moment" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Half speed segment" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateBirthdayCardBlue"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Birthday blue frame preview" android:background="#30333D" android:src="@drawable/template_frame_birthday_blue" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Birthday blue frame" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Confetti + photo window" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateBirthdayFrameFloral"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Floral birthday preview" android:background="#30333D" android:src="@drawable/template_frame_birthday_floral" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Floral birthday" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Blue flowers + frame" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateBirthdayFrameGarden"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Garden birthday preview" android:background="#30333D" android:src="@drawable/template_frame_birthday_garden" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Garden birthday" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Flowers + photo window" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateCongratsRedFrame"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Congrats red frame preview" android:background="#30333D" android:src="@drawable/template_frame_congrats_red" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Congrats red frame" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Gold photo frame" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateCongratsPinkCard"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Pink congratulations preview" android:background="#30333D" android:src="@drawable/template_frame_congrats_pink" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Pink congratulations" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Pink greeting overlay" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateGoldConfetti"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Gold confetti preview" android:background="#30333D" android:src="@drawable/template_frame_gold_confetti" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Gold confetti" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Sparkle text overlay" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTemplateFlowerCongrats"
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#171922"
                app:cardCornerRadius="16dp"
                app:strokeColor="#66F5A8D0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="142dp" android:contentDescription="Flower congratulations preview" android:background="#30333D" android:src="@drawable/template_frame_congrats_flower" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Flower congratulations" android:textColor="@color/textColor" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Floral greeting card" android:textColor="@color/toolTextInactive" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
